# Copy to .env and fill in what you want to switch on. Everything works without any keys (simulation mode).

# --- AI assistant (optional) ---
# When set, the job assistant uses Claude to understand requests; otherwise the built-in offline parser is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Delivery providers (not connected yet — quotes are simulated until these are set) ---
# Uber Direct: Client ID, Client secret and Customer ID from the Direct dashboard (Developer tab).
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
# Waymo: no public API — fill in only if a partner integration is agreed.
WAYMO_PARTNER_API_KEY=
WAYMO_PARTNER_BASE_URL=

# --- Device bridges (not connected yet — commands run on the digital twin) ---
MAVLINK_BRIDGE_URL=        # e.g. ws://localhost:8088 (MAVSDK server / mavlink2rest)
ROSBRIDGE_URL=             # e.g. ws://localhost:9090 (rosbridge_suite)
VDA5050_MQTT_URL=          # e.g. mqtt://localhost:1883 (VDA 5050 broker)
VENDOR_API_BASE_URL=       # telematics / driver-app API
DEVICE_MQTT_URL=           # generic MQTT devices

PORT=8787
